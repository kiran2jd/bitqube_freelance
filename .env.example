# Environment Variables Template for BitQube Freelance

# --- General & Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
PROJECT_NAME="BitQube Freelance"
API_V1_STR=/api/v1
DOMAIN=localhost
FRONTEND_URL=http://localhost:5173
DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR

# --- Security & Cryptography ---
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL Database ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=bitqube_dev
# Format: postgresql+asyncpg://user:pass@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_password@localhost:5432/bitqube_dev
# Sync URL for Alembic migrations
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres_dev_password@localhost:5432/bitqube_dev

# --- Object Storage (DigitalOcean Spaces / Local MinIO) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=bitqube-documents-dev
S3_REGION=blr1

# --- Payment Gateway (Razorpay Primary, Fiat Only: INR) ---
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_placeholder
PLATFORM_FEE_PERCENTAGE=10.0

# --- Email Notifications ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=notifications@bitqube.org
EMAILS_FROM_NAME="BitQube Freelance"

# --- Feature Flags ---
FEATURE_FLAG_BTQ_PAYMENTS=false
FEATURE_FLAG_QUBEX_BENEFITS=false
